{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Load OpenAI Key",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/load-openai-key.ps1",
                "-ItemName",
                "Lexile OpenAI Key"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run cloc (PowerShell)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/run-cloc.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "QC: 1 Black: format",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "black", "."],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "QC: 2 Ruff: lint",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "ruff", "check"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "QC: 2 Ruff: fix",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "ruff", "check", "--fix"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "QC: 3 Pyright: type-check",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "pyright"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "QC: 4 Pytest: run tests",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "pytest"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "QC: 4 Pytest: run tests with coverage",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "pytest", "--cov=src/lexile_corpus_tuner", "--cov-report=term-missing"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "PoshQC: 1 format",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { Import-Module '${workspaceFolder}/scripts/powershell/PoshQC'; Invoke-PoshQCFormat -Root '${workspaceFolder}' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Formats PowerShell files using Invoke-Formatter and repo PSScriptAnalyzer settings."
        },
        {
            "label": "PoshQC: 2 analyze",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { Import-Module '${workspaceFolder}/scripts/powershell/PoshQC'; Invoke-PoshQCAnalyze -Root '${workspaceFolder}' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Runs PSScriptAnalyzer with strict settings and fails on any findings."
        },
        {
            "label": "PoshQC: 2b autofix (PSSA -Fix)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { Import-Module '${workspaceFolder}/scripts/powershell/PoshQC'; $files = Get-ChildItem -Path '${workspaceFolder}' -Recurse -Include *.ps1, *.psm1 -File; if ($files) { foreach ($f in $files) { Invoke-ScriptAnalyzer -Path $f.FullName -Settings '${workspaceFolder}/scripts/powershell/PoshQC/settings/pssa.settings.psd1' -Severity Error,Warning,Information -Fix } } else { Write-Host 'No PowerShell files found under workspace.' } }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Runs PSScriptAnalyzer with -Fix to auto-apply supported fixes for PowerShell files."
        },
        {
            "label": "PoshQC: 4 test (Pester)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { Import-Module '${workspaceFolder}/scripts/powershell/PoshQC'; Invoke-PoshQCTest -Root '${workspaceFolder}' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "detail": "Runs Pester with repo configuration and JUnit output."
        },
        {
            "label": "QC: 5 Run All Checks",
            "dependsOn": [
                "QC: Black: format",
                "QC: Ruff: lint",
                "QC: Pyright: type-check",
                "QC: Pytest: run tests with coverage",
                "PoshQC: 1 format",
                "PoshQC: 2 analyze",
                "PoshQC: 4 test (Pester)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
              "kind": "build",
              "isDefault": false
            }
        },
        {
            "label": "QC: 0 Fix All",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/fix-all.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "group": {
              "kind": "build",
              "isDefault": true
            }
        },
        {
            "label": "Git: Collect Commit Context",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/collect-commit-context.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "detail": "Collects git diff and status information for commit message generation"
        },
        {
            "label": "Git: Collect Pull Request Context",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/collect-pull-request-context.ps1",
                "-Base",
                "${input:PRBaseBranch}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "detail": "Collects git PR context comparing current branch to specified base branch"
        },
            {
      "label": "Dev: New GitHub Feature Issue (manual)",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "create",
        "--template",
        "feature-request.md",
        "--web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Opens browser with .github/ISSUE_TEMPLATE/feature-request.md via gh (requires gh CLI auth)."
    },
    {
      "label": "Dev: 2 Promote Potential to GitHub Issue",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-tools/potential-to-issue.ps1",
        "-PotentialPath",
        "${input:PotentialFilePath}",
        "-PromotionType",
        "${input:PotentialPromotionType}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Creates a feature issue from a potential file using gh issue create (non-interactive)."
    },
    {
      "label": "Dev: 5 Link Feature Docs to GitHub",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-tools/link-feature-docs.ps1",
        "-IssueNumber",
        "${input:LinkIssueNumber}",
        "-FeatureName",
        "${input:LinkFeatureName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Adds/updates a Feature Docs section in an issue with links to user-story/spec/plan."
    },
    {
      "label": "Dev: 4 Link GitHub Parent/Child Issues",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-tools/link-parent-child.ps1",
        "-ChildIssueNumber",
        "${input:ChildIssueNumber}",
        "-ParentIssueNumber",
        "${input:ParentIssueNumber}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Adds child link to parent tracking issue and comments on the child with the parent link."
    },
    {
      "label": "Dev: 3 Create Active Folder",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-tools/new-active-feature-folder.ps1",
        "-FeatureName",
        "${input:ActiveFeatureName}",
        "-Type",
        "${input:ActiveWorkType}",
        "-IssueNumber",
        "${input:ActiveIssueNumber}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Copies docs/features/templates/feature into docs/features/active/<name> and opens the files."
    },
    {
      "label": "Dev: New GitHub Bug Issue",
      "type": "shell",
      "command": "gh",
      "args": [
        "issue",
        "create",
        "--template",
        "bug-report.md",
        "--web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Opens browser with .github/ISSUE_TEMPLATE/bug-report.md via gh (requires gh CLI auth)."
    },
    {
      "label": "Dev: Install PowerShell Tooling",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { Import-Module '${workspaceFolder}/scripts/powershell/PoshQC'; Install-PoshQCTools }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Installs PSScriptAnalyzer and Pester (CurrentUser scope) for repo tasks."
    },
    {
      "label": "Dev: 1A New Potential Bug",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-tools/new-potential-bug-entry.ps1",
        "-ShortName",
        "${input:PotentialBugShortName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Creates a dated potential bug file from the automation template for later promotion."
    },
        {
            "label": "Dev: 1 New Potential Entry",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev-tools/new-potential-entry.ps1",
                "-ShortName",
                "${input:PotentialShortName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "detail": "Creates a dated potential feature file from the template and opens it plus backlog.md for editing."
        }
    ],
  "inputs": [
    {
      "id": "PRBaseBranch",
      "type": "promptString",
      "description": "Base branch for PR comparison (e.g., development, main)",
      "default": "development"
    },
    {
      "id": "PotentialShortName",
      "type": "promptString",
      "description": "Short name (kebab-case, e.g., notes-feature)",
      "default": "notes-feature"
    },
    {
      "id": "PotentialBugShortName",
      "type": "promptString",
      "description": "Short name (kebab-case, e.g., api-timeout-bug)",
      "default": "api-timeout-bug"
    },
        {
      "id": "PotentialFilePath",
      "type": "promptString",
      "description": "Path to potential feature file",
      "default": "docs/features/potential/2025-12-01-new-feature.md"
    },
    {
      "id": "PotentialPromotionType",
      "type": "pickString",
      "description": "Promotion type / label to apply",
      "options": [
        "epic",
        "feature",
        "refactor",
        "bug"
      ],
      "default": "feature"
    },
        {
      "id": "ActiveFeatureName",
      "type": "promptString",
      "description": "Feature folder name (kebab/underscore-case, e.g., notes_feature)",
      "default": "new_feature"
    },
    {
      "id": "ActiveWorkType",
      "type": "pickString",
      "description": "Template type",
      "options": [
        "feature",
        "refactor",
        "epic"
      ],
      "default": "feature"
    },
    {
      "id": "ActiveIssueNumber",
      "type": "promptString",
      "description": "Issue number (optional, e.g., 14)",
      "default": "auto"
        },
        {
            "id": "LinkIssueNumber",
            "type": "promptString",
            "description": "Issue number to update (e.g., 14)",
            "default": ""
        },
        {
            "id": "LinkFeatureName",
            "type": "promptString",
            "description": "Feature folder name (e.g., new_feature)",
            "default": "new_feature"
        },
    {
      "id": "ChildIssueNumber",
      "type": "promptString",
      "description": "Child issue number to link (e.g., 15)",
      "default": ""
    },
    {
      "id": "ParentIssueNumber",
      "type": "promptString",
      "description": "Parent tracking issue number (e.g., 10)",
      "default": "10"
        }
    ]
}
